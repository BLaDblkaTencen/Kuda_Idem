# Скопируйте этот файл в .env и заполните значения.

# База данных. По умолчанию — встроенный PostgreSQL без Docker (данные в папке .data/).
DATABASE_URL=pglite:./.data/pglite
# Вариант с Docker (npm run db:up):
# DATABASE_URL=postgres://kuda:kuda_dev_password@localhost:5433/kuda_idem

# Порт API-сервера
PORT=3000

# development | production
NODE_ENV=development

# Токен бота от @BotFather. Пока пусто — сервер работает без бота.
# Для разработки используйте ОТДЕЛЬНОГО бота, не того, что опубликован на Cloudflare:
# один бот не может работать и на вебхуке, и на опросе одновременно.
BOT_TOKEN=

# polling — бот сам опрашивает Telegram (локально). На Cloudflare задан webhook (wrangler.jsonc).
BOT_MODE=polling

# Публичный HTTPS-адрес Mini App (нужен для кнопки в боте). Пока можно оставить пустым.
WEB_APP_URL=

# Короткое имя Mini App из @BotFather (/newapp) — для ссылок вида t.me/<бот>/<имя>?startapp=...
MINI_APP_SHORT_NAME=

# Адрес фронтенда, которому разрешено обращаться к API с другого адреса (CORS). Локально не нужен:
# экраны (npm run dev:web) ходят к API через прокси Vite. Пригодится, если экраны живут на отдельном домене.
CORS_ORIGIN=http://localhost:5173

# Папка с собранными экранами (apps/web/dist), которые отдаёт сервер Node.js. Пусто — путь по умолчанию
# внутри репозитория. Нужна, только если сервер запускается из другого места (например, в Docker).
WEB_DIST_DIR=

# Шифрованное соединение с базой хостинга без проверки сертификата: DATABASE_SSL=no-verify.
# Тогда в самом DATABASE_URL не должно быть параметра sslmode.
DATABASE_SSL=

# Вымышленные тестовые места (18 шт.) для экспериментов: true — загрузить при запуске, если их ещё нет,
# и предлагать вместе с реальными; false — скрыть. Реальные места всегда берутся из data/places-sevastopol.csv.
SEED_TEST_PLACES=false

# Только для разработки: вход без Telegram через заголовок X-Dev-User-Id.
# В production всегда выключено.
DEV_AUTH=true
